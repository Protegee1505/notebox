#!/usr/bin/env python3
"""Check the committed budgets against the ceilings in PLAN.md.

This is the static half of the gate: it catches a budget being quietly raised.
Runtime measurements are recorded by the phase that produces them and checked
here once measurement files exist (Phase 8). It deliberately prints which half
ran so a green result cannot be mistaken for a performance pass.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BUDGETS = ROOT / "docs" / "budgets.toml"

# Building must not fill the home partition: on this workspace it is only
# 4.8 GB, while the overlay disk is much larger. Caches and the Cargo target
# directory live outside home; see docs/DISK.md. Keep enough headroom for a
# seed restore or a new worktree before the target guard can move it.
HOME_FREE_FLOOR = 1200 * 1024 * 1024

# Ceilings from PLAN.md, "Starting budgets".
CEILINGS = {
    ("desktop", "cold_start_ms"): 600,
    ("desktop", "open_note_ms"): 50,
    ("desktop", "typing_dropped_frames"): 0,
    ("search", "notes"): 10000,
    ("search", "max_ms"): 100,
    ("web", "first_load_brotli_mb"): 3,
    ("android", "apk_mb"): 25,
    ("installer", "desktop_mb"): 20,
}


def main() -> int:
    try:
        data = tomllib.loads(BUDGETS.read_text())
    except FileNotFoundError:
        print(f"budget-check: missing {BUDGETS}", file=sys.stderr)
        return 1
    except tomllib.TOMLDecodeError as exc:
        print(f"budget-check: invalid TOML: {exc}", file=sys.stderr)
        return 1

    home = Path.home()
    home_free = shutil.disk_usage(home).free
    failures = []
    if home_free < HOME_FREE_FLOOR:
        failures.append(
            f"home partition {home} has only {home_free // (1024 * 1024)} MiB "
            "free; move build caches off it (see docs/DISK.md)"
        )

    guard = ROOT / "scripts" / "disk-guard.sh"
    guard_checked = False
    if guard.is_file():
        result = subprocess.run(
            ["bash", str(guard), "--check", "--quiet"],
            capture_output=True,
            text=True,
            check=False,
        )
        guard_checked = True
        if result.returncode != 0:
            detail = " ".join(
                line
                for line in (result.stderr or result.stdout).splitlines()
                if line.strip()
            )
            failures.append(
                detail or "a Cargo target is still on the home partition"
            )

    for (section, key), ceiling in CEILINGS.items():
        value = data.get(section, {}).get(key)
        if value is None:
            failures.append(f"missing {section}.{key}")
        elif value > ceiling:
            failures.append(f"{section}.{key}={value} exceeds ceiling {ceiling}")

    if failures:
        print("budget-check: FAIL", file=sys.stderr)
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        return 1

    print(
        "budget-check: PASS (static ceilings"
        f"{' and home target guard' if guard_checked else ''}; runtime "
        f"measurements not collected yet); {home_free // (1024 * 1024)} MiB "
        f"free on {home}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
